{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivarium-collective.github.io/viva-marketplace/schemas/composability-graph.schema.json",
  "title": "viva-marketplace composability graph (EXPERIMENTAL)",
  "description": "Best-effort static cross-repo port-compatibility graph, generated by viva_marketplace.composability alongside ecosystem-index.json. Type matching is exact-string equality only — this is a discovery hint, not a verified wiring guarantee. See viva_marketplace/composability.py module docstring.",
  "type": "object",
  "required": ["schema_version", "experimental", "edges"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "experimental": { "const": true },
    "note": { "type": "string" },
    "n_processes_with_ports": { "type": "integer", "minimum": 0 },
    "n_edges": { "type": "integer", "minimum": 0 },
    "n_cross_repo_edges": { "type": "integer", "minimum": 0 },
    "n_generic_type_edges": { "type": "integer", "minimum": 0 },
    "n_cross_repo_specific_type_edges": { "type": "integer", "minimum": 0 },
    "truncated": { "type": "boolean" },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "from", "to", "cross_repo", "generic_type"],
        "properties": {
          "type": { "type": "string" },
          "from": { "$ref": "#/$defs/endpoint" },
          "to": { "$ref": "#/$defs/endpoint" },
          "cross_repo": { "type": "boolean" },
          "generic_type": {
            "type": "boolean",
            "description": "True when `type` is one of process-bigraph's own bare core/primitive type names (float, string, map, …) — matches on these alone carry much weaker domain-compatibility signal than a domain-specific type."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": ["repo", "process", "port"],
      "properties": {
        "repo": { "type": "string" },
        "process": { "type": "string" },
        "port": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
